<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
>
  <changeSet id="1.1-create-organisation" author="waste-organisations">
    <createTable tableName="organisation">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="name" type="text">
        <constraints nullable="false" />
      </column>
      <column name="trading_name" type="text" />
      <column name="companies_house_number" type="text" />
      <column name="home_nation" type="text">
        <constraints nullable="false" />
      </column>
      <column name="organisation_type_id" type="uuid" />
      <column name="valid_from" type="timestamptz">
        <constraints nullable="false" />
      </column>
      <column name="valid_to" type="timestamptz" />
      <column name="created_at" type="timestamptz">
        <constraints nullable="false" />
      </column>
      <column name="updated_at" type="timestamptz">
        <constraints nullable="false" />
      </column>
    </createTable>
  </changeSet>

  <changeSet id="1.1-create-organisation-type" author="waste-organisations">
    <createTable tableName="organisation_type">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="code" type="text">
        <constraints nullable="false" />
      </column>
    </createTable>
  </changeSet>

  <changeSet id="1.1-create-address-usagetype" author="waste-organisations">
    <createTable tableName="address_usagetype">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="name" type="text">
        <constraints nullable="false" />
      </column>
    </createTable>
  </changeSet>

  <changeSet id="1.1-create-address" author="waste-organisations">
    <createTable tableName="address">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="address_line" type="text" />
      <column name="sub_building_name" type="text" />
      <column name="building_name" type="text" />
      <column name="building_number" type="text" />
      <column name="street" type="text" />
      <column name="locality" type="text" />
      <column name="region" type="text" />
      <column name="postal_code" type="text" />
      <column name="po_box" type="text" />
      <column name="country_iso" type="text" />
      <column name="country_name" type="text" />
      <column name="created_at" type="timestamptz">
        <constraints nullable="false" />
      </column>
      <column name="updated_at" type="timestamptz">
        <constraints nullable="false" />
      </column>
    </createTable>
  </changeSet>

  <!-- A UK address is exactly one whose ISO 3166-1 alpha-2 code is GB, so is_uk_address is derived and can never contradict country_iso -->
  <changeSet id="1.1-address-is-uk-address" author="waste-organisations">
    <sql>
      ALTER TABLE address ADD COLUMN is_uk_address boolean GENERATED ALWAYS AS (country_iso = 'GB') STORED;
    </sql>
    <rollback>
      ALTER TABLE address DROP COLUMN is_uk_address;
    </rollback>
  </changeSet>

  <changeSet id="1.1-create-organisation-address" author="waste-organisations">
    <createTable tableName="organisation_address">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="organisation_id" type="uuid">
        <constraints nullable="false" />
      </column>
      <column name="address_id" type="uuid">
        <constraints nullable="false" />
      </column>
      <column name="usage_type_id" type="uuid">
        <constraints nullable="false" />
      </column>
      <column name="valid_from" type="timestamptz">
        <constraints nullable="false" />
      </column>
      <column name="valid_to" type="timestamptz" />
      <column name="created_at" type="timestamptz">
        <constraints nullable="false" />
      </column>
      <column name="updated_at" type="timestamptz">
        <constraints nullable="false" />
      </column>
    </createTable>
  </changeSet>

  <changeSet id="1.1-fk-organisation-organisation-type" author="waste-organisations">
    <addForeignKeyConstraint
      constraintName="fk_organisation_organisation_type"
      baseTableName="organisation"
      baseColumnNames="organisation_type_id"
      referencedTableName="organisation_type"
      referencedColumnNames="id"
      onDelete="RESTRICT"
    />
  </changeSet>

  <changeSet id="1.1-fk-organisation-address-organisation" author="waste-organisations">
    <addForeignKeyConstraint
      constraintName="fk_organisation_address_organisation"
      baseTableName="organisation_address"
      baseColumnNames="organisation_id"
      referencedTableName="organisation"
      referencedColumnNames="id"
      onDelete="RESTRICT"
    />
  </changeSet>

  <changeSet id="1.1-fk-organisation-address-address" author="waste-organisations">
    <addForeignKeyConstraint
      constraintName="fk_organisation_address_address"
      baseTableName="organisation_address"
      baseColumnNames="address_id"
      referencedTableName="address"
      referencedColumnNames="id"
      onDelete="RESTRICT"
    />
  </changeSet>

  <changeSet id="1.1-fk-organisation-address-usage-type" author="waste-organisations">
