    <createIndex indexName="ix_organisation_address_organisation_id" tableName="organisation_address">
      <column name="organisation_id" />
    </createIndex>
  </changeSet>

  <changeSet id="1.1-ix-organisation-address-address-id" author="waste-organisations">
    <createIndex indexName="ix_organisation_address_address_id" tableName="organisation_address">
      <column name="address_id" />
    </createIndex>
  </changeSet>

  <changeSet id="1.1-ix-organisation-address-usage-type-id" author="waste-organisations">
    <createIndex indexName="ix_organisation_address_usage_type_id" tableName="organisation_address">
      <column name="usage_type_id" />
    </createIndex>
  </changeSet>

  <changeSet id="1.1-uq-address-usagetype-name" author="waste-organisations">
    <addUniqueConstraint constraintName="uq_address_usagetype_name" tableName="address_usagetype" columnNames="name" />
  </changeSet>

  <changeSet id="1.1-uq-organisation-type-code" author="waste-organisations">
    <addUniqueConstraint constraintName="uq_organisation_type_code" tableName="organisation_type" columnNames="code" />
  </changeSet>

  <changeSet id="1.1-ck-organisation-valid-to" author="waste-organisations">
    <sql>
      ALTER TABLE organisation ADD CONSTRAINT ck_organisation_valid_to CHECK (valid_to IS NULL OR valid_to > valid_from);
    </sql>
    <rollback>
      ALTER TABLE organisation DROP CONSTRAINT ck_organisation_valid_to;
    </rollback>
  </changeSet>

  <changeSet id="1.1-ck-organisation-home-nation" author="waste-organisations">
    <sql>
      ALTER TABLE organisation ADD CONSTRAINT ck_organisation_home_nation CHECK (home_nation IN ('GB-ENG', 'GB-SCT', 'GB-WLS', 'GB-NIR'));
    </sql>
    <rollback>
      ALTER TABLE organisation DROP CONSTRAINT ck_organisation_home_nation;
    </rollback>
  </changeSet>

  <changeSet id="1.1-ck-address-country-iso" author="waste-organisations">
    <sql>
      ALTER TABLE address ADD CONSTRAINT ck_address_country_iso CHECK (country_iso IS NULL OR country_iso ~ '^[A-Z]{2}$');
    </sql>
    <rollback>
      ALTER TABLE address DROP CONSTRAINT ck_address_country_iso;
    </rollback>
  </changeSet>

  <!-- A UK address needs a postcode; an overseas one may not have any. COALESCE matters: a CHECK
       passes when its expression is NULL, so btrim(NULL) <> '' alone would let a missing postcode through -->
  <changeSet id="1.1-ck-address-uk-postal-code" author="waste-organisations">
    <sql>
      ALTER TABLE address ADD CONSTRAINT ck_address_uk_postal_code CHECK (country_iso IS DISTINCT FROM 'GB' OR COALESCE(btrim(postal_code), '') &lt;&gt; '');
    </sql>
    <rollback>
      ALTER TABLE address DROP CONSTRAINT ck_address_uk_postal_code;
    </rollback>
  </changeSet>

  <!-- The premises must be identifiable, but not every address has a number: a named building, a unit or a
       PO box will do. Blank values do not count -->
  <changeSet id="1.1-ck-address-premises" author="waste-organisations">
    <sql>
      ALTER TABLE address ADD CONSTRAINT ck_address_premises CHECK (num_nonnulls(NULLIF(btrim(building_number), ''), NULLIF(btrim(building_name), ''), NULLIF(btrim(sub_building_name), ''), NULLIF(btrim(po_box), ''), NULLIF(btrim(address_line), '')) &gt; 0);
    </sql>
    <rollback>
      ALTER TABLE address DROP CONSTRAINT ck_address_premises;
    </rollback>
  </changeSet>

  <changeSet id="1.1-ck-organisation-address-valid-to" author="waste-organisations">
    <sql>
      ALTER TABLE organisation_address ADD CONSTRAINT ck_organisation_address_valid_to CHECK (valid_to IS NULL OR valid_to > valid_from);
    </sql>
    <rollback>
      ALTER TABLE organisation_address DROP CONSTRAINT ck_organisation_address_valid_to;
    </rollback>
  </changeSet>

  <changeSet id="1.1-ux-organisation-address-current" author="waste-organisations">
    <sql>
      CREATE UNIQUE INDEX ux_organisation_address_current ON organisation_address (organisation_id, usage_type_id) WHERE valid_to IS NULL;
    </sql>
    <rollback>
      DROP INDEX ux_organisation_address_current;
    </rollback>
  </changeSet>

