<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
>
  <changeSet id="1.1-create-organisation" author="waste-organisations">
    <createTable tableName="organisation">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="organisation_name" type="text">
        <constraints nullable="false" />
      </column>
      <column name="trading_name" type="text" />
      <column name="companies_house_number" type="text" />
      <column name="home_nation_code" type="text">
        <constraints nullable="false" />
      </column>
      <column name="nation_code" type="text" />
      <column name="main_activity_sic" type="text" />
      <column name="organisation_type_code" type="text" />
      <column name="organisation_sub_type_code" type="text" />
      <column name="organisation_type" type="text" />
      <column name="organisation_size" type="integer" />
      <column name="turnover" type="bigint" />
      <column name="valid_from" type="timestamptz">
        <constraints nullable="false" />
      </column>
      <column name="valid_to" type="timestamptz" />
      <column name="created_at" type="timestamptz">
        <constraints nullable="false" />
      </column>
      <column name="updated_at" type="timestamptz">
        <constraints nullable="false" />
      </column>
    </createTable>
  </changeSet>

  <changeSet id="1.1-create-organisation-type" author="waste-organisations">
    <createTable tableName="organisation_type">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="organisation_id" type="uuid">
        <constraints nullable="false" />
      </column>
      <column name="is_a_partnership" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false" />
      </column>
      <column name="organisation_type" type="text" />
    </createTable>
  </changeSet>

  <changeSet id="1.1-create-address-usagetype" author="waste-organisations">
    <createTable tableName="address_usagetype">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="usage_type" type="text">
        <constraints nullable="false" />
      </column>
    </createTable>
  </changeSet>

  <changeSet id="1.1-create-address" author="waste-organisations">
    <createTable tableName="address">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="address_line1" type="text" />
      <column name="address_line2" type="text" />
      <column name="city" type="text" />
      <column name="county" type="text" />
      <column name="postcode" type="text" />
      <column name="country" type="text" />
      <column name="state_province_or_region" type="text" />
      <column name="phone_number" type="text" />
      <column name="created_at" type="timestamptz">
        <constraints nullable="false" />
      </column>
      <column name="updated_at" type="timestamptz">
        <constraints nullable="false" />
      </column>
    </createTable>
  </changeSet>

  <changeSet id="1.1-create-organisation-address" author="waste-organisations">
    <createTable tableName="organisation_address">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="organisation_id" type="uuid">
        <constraints nullable="false" />
      </column>
      <column name="address_id" type="uuid">
        <constraints nullable="false" />
      </column>
      <column name="usage_type_id" type="uuid">
        <constraints nullable="false" />
      </column>
      <column name="valid_from" type="timestamptz">
        <constraints nullable="false" />
      </column>
      <column name="valid_to" type="timestamptz" />
      <column name="created_at" type="timestamptz">
        <constraints nullable="false" />
      </column>
      <column name="updated_at" type="timestamptz">
        <constraints nullable="false" />
      </column>
    </createTable>
  </changeSet>

  <changeSet id="1.1-fk-organisation-type-organisation" author="waste-organisations">
    <addForeignKeyConstraint
      constraintName="fk_organisation_type_organisation"
      baseTableName="organisation_type"
      baseColumnNames="organisation_id"
      referencedTableName="organisation"
      referencedColumnNames="id"
      onDelete="RESTRICT"
    />
  </changeSet>

  <changeSet id="1.1-fk-organisation-address-organisation" author="waste-organisations">
    <addForeignKeyConstraint
      constraintName="fk_organisation_address_organisation"
      baseTableName="organisation_address"
      baseColumnNames="organisation_id"
      referencedTableName="organisation"
      referencedColumnNames="id"
      onDelete="RESTRICT"
    />
  </changeSet>

  <changeSet id="1.1-fk-organisation-address-address" author="waste-organisations">
    <addForeignKeyConstraint
      constraintName="fk_organisation_address_address"
      baseTableName="organisation_address"
      baseColumnNames="address_id"
      referencedTableName="address"
      referencedColumnNames="id"
      onDelete="RESTRICT"
    />
  </changeSet>

  <changeSet id="1.1-fk-organisation-address-usage-type" author="waste-organisations">
    <addForeignKeyConstraint
      constraintName="fk_organisation_address_usage_type"
      baseTableName="organisation_address"
      baseColumnNames="usage_type_id"
      referencedTableName="address_usagetype"
      referencedColumnNames="id"
      onDelete="RESTRICT"
    />
  </changeSet>

  <changeSet id="1.1-ix-organisation-address-organisation-id" author="waste-organisations">
    <createIndex indexName="ix_organisation_address_organisation_id" tableName="organisation_address">
      <column name="organisation_id" />
    </createIndex>
  </changeSet>

  <changeSet id="1.1-ix-organisation-address-address-id" author="waste-organisations">
    <createIndex indexName="ix_organisation_address_address_id" tableName="organisation_address">
      <column name="address_id" />
    </createIndex>
  </changeSet>

  <changeSet id="1.1-ix-organisation-address-usage-type-id" author="waste-organisations">
    <createIndex indexName="ix_organisation_address_usage_type_id" tableName="organisation_address">
      <column name="usage_type_id" />
    </createIndex>
  </changeSet>

  <changeSet id="1.1-ix-address-address-line1-postcode" author="waste-organisations">
    <createIndex indexName="ix_address_address_line1_postcode" tableName="address">
      <column name="address_line1" />
      <column name="postcode" />
    </createIndex>
  </changeSet>

  <changeSet id="1.1-uq-address-usagetype-usage-type" author="waste-organisations">
    <addUniqueConstraint
      constraintName="uq_address_usagetype_usage_type"
      tableName="address_usagetype"
      columnNames="usage_type"
    />
  </changeSet>

  <changeSet id="1.1-uq-organisation-type-organisation-id" author="waste-organisations">
    <addUniqueConstraint
      constraintName="uq_organisation_type_organisation_id"
      tableName="organisation_type"
      columnNames="organisation_id"
    />
  </changeSet>

  <changeSet id="1.1-ck-organisation-valid-to" author="waste-organisations">
    <sql>
      ALTER TABLE organisation ADD CONSTRAINT ck_organisation_valid_to CHECK (valid_to IS NULL OR valid_to > valid_from);
    </sql>
    <rollback>
      ALTER TABLE organisation DROP CONSTRAINT ck_organisation_valid_to;
    </rollback>
  </changeSet>

  <changeSet id="1.1-ck-organisation-address-valid-to" author="waste-organisations">
    <sql>
      ALTER TABLE organisation_address ADD CONSTRAINT ck_organisation_address_valid_to CHECK (valid_to IS NULL OR valid_to > valid_from);
    </sql>
    <rollback>
      ALTER TABLE organisation_address DROP CONSTRAINT ck_organisation_address_valid_to;
    </rollback>
  </changeSet>

  <changeSet id="1.1-ux-organisation-address-current" author="waste-organisations">
    <sql>
      CREATE UNIQUE INDEX ux_organisation_address_current ON organisation_address (organisation_id, usage_type_id) WHERE valid_to IS NULL;
    </sql>
    <rollback>
      DROP INDEX ux_organisation_address_current;
    </rollback>
  </changeSet>

  <changeSet id="1.1-seed-address-usagetype" author="waste-organisations">
    <insert tableName="address_usagetype">
      <column name="id" value="00000000-0000-0000-0000-000000000001" />
      <column name="usage_type" value="Registered" />
    </insert>
    <insert tableName="address_usagetype">
      <column name="id" value="00000000-0000-0000-0000-000000000002" />
      <column name="usage_type" value="Audit" />
    </insert>
    <insert tableName="address_usagetype">
      <column name="id" value="00000000-0000-0000-0000-000000000003" />
      <column name="usage_type" value="ServiceOfNotice" />
    </insert>
    <insert tableName="address_usagetype">
      <column name="id" value="00000000-0000-0000-0000-000000000004" />
      <column name="usage_type" value="Principal" />
    </insert>
    <insert tableName="address_usagetype">
      <column name="id" value="00000000-0000-0000-0000-000000000005" />
      <column name="usage_type" value="Organisation" />
    </insert>
    <insert tableName="address_usagetype">
      <column name="id" value="00000000-0000-0000-0000-000000000006" />
      <column name="usage_type" value="Site" />
    </insert>
    <rollback>
      DELETE FROM address_usagetype WHERE usage_type IN ('Registered', 'Audit', 'ServiceOfNotice', 'Principal', 'Organisation', 'Site');
    </rollback>
  </changeSet>

  <changeSet id="1.1-tag-v1.1.0" author="waste-organisations">
    <tagDatabase tag="v1.1.0" />
  </changeSet>
</databaseChangeLog>
