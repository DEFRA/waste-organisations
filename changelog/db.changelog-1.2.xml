  <!-- A sole trader or partnership has no registered name, only a trading name. The check is the API rule in the
       database's terms: a non-blank name, or no Companies House number and a non-blank trading name -->
  <changeSet id="1.2-organisation-name-nullable" author="waste-organisations">
    <dropNotNullConstraint tableName="organisation" columnName="name" columnDataType="text" />
    <sql>
      ALTER TABLE organisation ADD CONSTRAINT ck_organisation_name CHECK (COALESCE(btrim(name), '') &lt;&gt; '' OR (companies_house_number IS NULL AND COALESCE(btrim(trading_name), '') &lt;&gt; ''));
    </sql>
    <rollback>
      <sql>
        ALTER TABLE organisation DROP CONSTRAINT ck_organisation_name;
      </sql>
      <addNotNullConstraint tableName="organisation" columnName="name" columnDataType="text" />
    </rollback>
  </changeSet>

  <!-- Postgres keeps the check's expression bound to the renamed column, so the constraint is renamed, not recreated -->
  <changeSet id="1.2-organisation-rename-regulator-nation" author="waste-organisations">
    <renameColumn
      tableName="organisation"
      oldColumnName="home_nation"
      newColumnName="regulator_nation"
      columnDataType="text"
    />
    <sql>
      ALTER TABLE organisation RENAME CONSTRAINT ck_organisation_home_nation TO ck_organisation_regulator_nation;
    </sql>
    <rollback>
      <sql>
        ALTER TABLE organisation RENAME CONSTRAINT ck_organisation_regulator_nation TO ck_organisation_home_nation;
      </sql>
      <renameColumn
        tableName="organisation"
        oldColumnName="regulator_nation"
        newColumnName="home_nation"
        columnDataType="text"
      />
    </rollback>
  </changeSet>

  <!-- The check is dropped and recreated explicitly rather than left to Postgres's automatic drop with the column,
       so the rollback is deterministic. The rollback does not restore address_line data; no environment holds any -->
  <changeSet id="1.2-address-drop-address-line" author="waste-organisations">
    <sql>
      ALTER TABLE address DROP CONSTRAINT ck_address_premises;
    </sql>
    <dropColumn tableName="address" columnName="address_line" />
    <sql>
      ALTER TABLE address ADD CONSTRAINT ck_address_premises CHECK (num_nonnulls(NULLIF(btrim(building_number), ''), NULLIF(btrim(building_name), ''), NULLIF(btrim(sub_building_name), ''), NULLIF(btrim(po_box), '')) &gt; 0);
    </sql>
    <rollback>
      <sql>
        ALTER TABLE address DROP CONSTRAINT ck_address_premises;
      </sql>
      <addColumn tableName="address">
        <column name="address_line" type="text" />
      </addColumn>
      <sql>
        ALTER TABLE address ADD CONSTRAINT ck_address_premises CHECK (num_nonnulls(NULLIF(btrim(building_number), ''), NULLIF(btrim(building_name), ''), NULLIF(btrim(sub_building_name), ''), NULLIF(btrim(po_box), ''), NULLIF(btrim(address_line), '')) &gt; 0);
      </sql>
    </rollback>
  </changeSet>

  <!-- The rollback does not restore country_name data; no environment holds any -->
  <changeSet id="1.2-address-drop-country-name" author="waste-organisations">
    <dropColumn tableName="address" columnName="country_name" />
    <rollback>
      <addColumn tableName="address">
        <column name="country_name" type="text" />
      </addColumn>
    </rollback>
  </changeSet>

  <!-- A UK address is one whose country_iso is GB, which the API and its consumers read from country_iso itself, so the
       derived column is dropped (review of 5 November 2026). No index or check refers to it; the rollback recomputes it -->
  <changeSet id="1.2-address-drop-is-uk-address" author="waste-organisations">
    <dropColumn tableName="address" columnName="is_uk_address" />
    <rollback>
      <sql>
        ALTER TABLE address ADD COLUMN is_uk_address boolean GENERATED ALWAYS AS (country_iso = 'GB') STORED;
      </sql>
    </rollback>
  </changeSet>

  <!-- An address is stored once and shared. NULLS NOT DISTINCT (Postgres 15 or later) makes two rows with the same
       values and the same absent parts a conflict, which a plain unique index would allow -->
  <changeSet id="1.2-ux-address-values" author="waste-organisations">
    <sql>
      CREATE UNIQUE INDEX ux_address_values ON address (sub_building_name, building_name, building_number, street, locality, region, postal_code, po_box, country_iso) NULLS NOT DISTINCT;
    </sql>
    <rollback>
      DROP INDEX ux_address_values;
    </rollback>
  </changeSet>

