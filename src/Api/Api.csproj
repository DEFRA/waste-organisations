<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>$(RootNamespace).Api</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.Http.Validation.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.HeaderPropagation" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="AspNetCore.HealthChecks.MongoDb" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.ClientInfo" Version="2.9.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Elastic.CommonSchema.Serilog" Version="9.0.0" />
    <PackageReference Include="Elastic.Serilog.Enrichers.Web" Version="9.0.0" />
    <PackageReference Include="MongoDB.Driver.Authentication.AWS" Version="3.12.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="AWSSDK.RDS" Version="4.0.107" />
    <!--
      Pinned so that AWSSDK.RDS 4.x can restore. MongoDB.Driver.Authentication.AWS 3.12.0 depends on
      AWSSDK.SecurityToken 3.7, which requires AWSSDK.Core < 4.0; this direct 4.x reference wins that
      resolution and the Mongo package is binary-compatible with Core 4.x. Remove this reference together
      with MongoDB.Driver.Authentication.AWS when Mongo is retired, or once that package targets AWS SDK v4
      (MongoDB driver 4.0, CSHARP-5696).
    -->
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.101.5" />
    <PackageReference Include="Swashbuckle.AspNetCore.ReDoc" Version="10.3.1" />
    <!-- added due to https://github.com/advisories/GHSA-v5pm-xwqc-g5wc -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageReference Include="Amazon.CloudWatch.EMF" Version="2.2.0" />
    <!-- added due to https://github.com/advisories/GHSA-pggp-6c3x-2xmx -->
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>
</Project>
