{
  "Mongo": {
    "DatabaseUri": "mongodb://127.0.0.1:27017",
    "DatabaseName": "waste-organisations"
  },
  "Postgres": {
    "Host": "127.0.0.1",
    "Port": 5432,
    "DatabaseName": "waste-organisations",
    "User": "postgres",
    "Password": "postgres",
    "UseIamAuthentication": false,
    "HealthCheckFailureStatus": "Unhealthy"
  },
  "DetailedErrors": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] {Message} {Properties}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Acl": {
    "Clients": {
      "Developer": {
        "Type": "ApiKey",
        "Secret": "developer-pwd",
        "Scopes": [
          "read",
          "write"
        ]
      },
      "IntegrationTest": {
        "Type": "OAuth",
        "Scopes": [
          "read",
          "write"
        ]
      }
    }
  }
}
